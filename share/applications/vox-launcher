#!/usr/bin/env python3
"""vox launcher — converts file:// URIs to paths and provides a welcome screen."""

import sys
import os
import subprocess
from urllib.parse import urlparse, unquote


def uri_to_path(uri: str) -> str:
    if uri.startswith("file://"):
        parsed = urlparse(uri)
        return unquote(parsed.path)
    return uri


def main():
    if len(sys.argv) < 2:
        print("\033[2J\033[H", end="")  # clear screen
        print("=" * 50)
        print("  🎧  Vox TTS Reader")
        print("  Piper neural text-to-speech")
        print("=" * 50)
        print()
        print("  Drag a file onto this window, or run:")
        print("    vox speak <filename>")
        print()
        print("  Supported: .txt  .md  .pdf  .epub")
        print()
        print("  Controls during playback:")
        print("    Space = pause/resume")
        print("     ←/→  = skip paragraphs")
        print("    q     = quit")
        print()
        print("=" * 50)
        input("\n  Press Enter to close...")
        return 0

    path = uri_to_path(sys.argv[1])

    if not os.path.exists(path):
        print(f"File not found: {path}")
        input("Press Enter to close...")
        return 1

    # Speak the file
    result = subprocess.run(["vox", "speak", path])
    print()
    input("Press Enter to close...")
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
