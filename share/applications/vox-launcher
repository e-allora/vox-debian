#!/usr/bin/env python3
"""vox reader — terminal-based reader with highlighted text and TTS."""

import sys
import os
import subprocess
import threading
import time
import termios
import tty
import shutil
from urllib.parse import urlparse, unquote


def uri_to_path(uri: str) -> str:
    if uri.startswith("file://"):
        return unquote(urlparse(uri).path)
    return uri


def clear_screen():
    sys.stdout.write("\033[2J\033[H")
    sys.stdout.flush()


def colored(text: str, code: str) -> str:
    colors = {
        "dim": "\033[2m",
        "bold": "\033[1m",
        "cyan": "\033[36m",
        "green": "\033[32m",
        "yellow": "\033[33m",
        "white": "\033[37m",
        "reset": "\033[0m",
    }
    return colors.get(code, "") + text + colors["reset"]


def render_view(full_text: str, meta: dict, idx: int, total: int, state: str):
    """Render the full reader view."""
    clear_screen()
    cols, rows = shutil.get_terminal_size((80, 24))

    # --- Header ---
    title = meta.get("title", "Unknown") or "Unknown"
    author = meta.get("author", "") or ""
    header = f" {colored(title, 'bold')}"
    if author:
        header += f"  by {author}"
    print(header)
    print(colored("─" * (cols - 1), "dim"))

    # --- Progress bar ---
    pct = int(100 * (idx + 1) / total) if total > 0 else 0
    bar_w = cols - 20
    filled = int(bar_w * (idx + 1) / total) if total > 0 else 0
    icons = {"playing": "🎧", "paused": "⏸", "done": "✅"}
    icon = icons.get(state, "  ")
    print(f" {icon} Para {idx+1}/{total}  │{'█' * filled}{'░' * (bar_w - filled)}│ {pct}%")
    print(colored("─" * (cols - 1), "dim"))

    # --- Text area ---
    available = rows - 7  # header + bar + footer
    if available < 5:
        available = 5

    # Find the window around the active paragraph
    start = max(0, idx - available // 2)
    end = min(len(full_text), start + available)
    if end - start < available and start > 0:
        start = max(0, end - available)

    for i in range(start, end):
        para = full_text[i]
        # Wrap to terminal width
        wrapped = [para[j:j+cols-2] for j in range(0, len(para), cols-2)]
        for wi, line in enumerate(wrapped):
            prefix = "▸ " if i == idx else "  "
            if i == idx and wi == 0:
                print(f"{prefix}{colored(line, 'cyan')}")
            elif i == idx:
                print(f"  {colored(line, 'cyan')}")
            else:
                print(f"{prefix}{colored(line, 'dim')}")

    # --- Footer ---
    print(colored("─" * (cols - 1), "dim"))
    print(f" {colored('[space]', 'green')} pause/play  "
          f"{colored('[←→]', 'green')} prev/next  "
          f"{colored('[q]', 'green')} quit  "
          f"{colored('[h]', 'green')} home")


def run_reader(path: str):
    """Run the full reader UI."""
    # Get paragraphs and metadata
    result = subprocess.run(
        ["vox", "info", "--json", path],
        capture_output=True,
        text=True,
    )

    # Fall back to vox info text output for metadata
    meta_raw = subprocess.run(
        ["vox", "info", path],
        capture_output=True,
        text=True,
    )

    # Parse metadata from text output
    meta = {"title": "Unknown", "author": "", "paragraphs": 0}
    for line in meta_raw.stdout.split("\n"):
        if line.startswith("Title:"):
            meta["title"] = line.split("Title:", 1)[1].strip()
        elif line.startswith("Author:"):
            meta["author"] = line.split("Author:", 1)[1].strip()
        elif line.startswith("Paragraphs:"):
            meta["paragraphs"] = int(line.split("Paragraphs:", 1)[1].strip())

    # Get paragraphs text
    from vox.reader import Reader

    r = Reader(path)
    paragraphs = r.paragraphs()
    total = len(paragraphs)

    if total == 0:
        print("No text found in this document.")
        input("Press Enter to close...")
        return

    # State
    idx = 0
    stopped = threading.Event()
    paused = threading.Event()
    state = "playing"
    render_lock = threading.Lock()

    class Speaker:
        def say(self, text):
            subprocess.run(
                ["spd-say", "-o", "piper", "-w", "--", text],
                timeout=60,
            )

    speaker = Speaker()

    def playback_thread():
        nonlocal idx, state
        while idx < total:
            if stopped.is_set():
                break
            if paused.is_set():
                time.sleep(0.1)
                continue
            state = "playing"
            with render_lock:
                render_view(paragraphs, meta, idx, total, state)
            speaker.say(paragraphs[idx])
            idx += 1
        state = "done"
        with render_lock:
            render_view(paragraphs, meta, min(idx, total - 1), total, state)
        stopped.set()

    def input_thread():
        nonlocal idx, state
        if not sys.stdin.isatty():
            return
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            while not stopped.is_set():
                ch = sys.stdin.read(1)
                if ch == " ":
                    if paused.is_set():
                        paused.clear()
                        state = "playing"
                    else:
                        paused.set()
                        state = "paused"
                    with render_lock:
                        render_view(paragraphs, meta, idx, total, state)
                elif ch == "q":
                    stopped.set()
                    paused.clear()
                elif ch == "\x1b":
                    seq = sys.stdin.read(2)
                    if seq == "[C":
                        idx = min(idx + 1, total - 1)
                        paused.set()
                        stopped.set()
                    elif seq == "[D":
                        idx = max(idx - 1, 0)
                        paused.set()
                        stopped.set()
                    elif seq == "[H":
                        idx = 0
                        paused.set()
                        stopped.set()
                elif ch == "h":
                    idx = 0
                    paused.set()
                    stopped.set()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)

    # Initial render
    render_view(paragraphs, meta, 0, total, "playing")

    play_t = threading.Thread(target=playback_thread, daemon=True)
    input_t = threading.Thread(target=input_thread, daemon=True)
    play_t.start()
    input_t.start()

    play_t.join()
    stopped.set()
    input_t.join(timeout=0.5)

    # Restore terminal if possible
    try:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, termios.tcgetattr(sys.stdin.fileno()))
    except termios.error:
        pass
    print()


def main():
    if len(sys.argv) < 2:
        clear_screen()
        print(colored("  Vox TTS Reader", "bold"))
        print(colored("  Piper neural text-to-speech", "dim"))
        print()
        print("  Drag a file onto the launcher or run:")
        print("    vox-launcher <file>")
        print()
        print("  Supported: .txt  .md  .pdf  .epub")
        input("\n  Press Enter to close...")
        return 0

    path = uri_to_path(sys.argv[1])
    if not os.path.exists(path):
        print(f"File not found: {path}")
        input("Press Enter to close...")
        return 1

    try:
        run_reader(path)
    except KeyboardInterrupt:
        print("\nStopped.")
    except Exception as e:
        print(f"\nError: {e}")
        try:
            input("Press Enter to close...")
        except (EOFError, KeyboardInterrupt):
            pass
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
